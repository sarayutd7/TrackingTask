/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://accounts.google.com https://alcdn.msauth.net 'unsafe-inline'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://*.workers.dev https://accounts.google.com https://login.microsoftonline.com https://api.open-meteo.com https://nominatim.openstreetmap.org; frame-src https://accounts.google.com; object-src 'none'; base-uri 'self'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

# No build step means index.html/js/css/sw.js keep the same filename on every
# deploy, so without this, browsers and Cloudflare's edge cache can keep
# serving an old cached copy indefinitely after a deploy. Force revalidation
# on every load instead (still cheap — a 304 when nothing changed).
/*.html
  Cache-Control: no-cache, must-revalidate

/*.js
  Cache-Control: no-cache, must-revalidate

/*.css
  Cache-Control: no-cache, must-revalidate

/sw.js
  Cache-Control: no-cache, must-revalidate
